---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			/* =========================================
   				日本語向けサイズ調整（ここから追加）
   				========================================= */

			/* 記事タイトル（一番上の大見出し） */
			.title h1 {
  			font-size: 2em !important;
  			line-height: 1.3 !important;
  			margin: 0 0 0.5em 0 !important;
			}

			/* 記事本文の H1（大見出し） */
			.prose h1 {
  			font-size: 1.8em !important;
  			margin-top: 2em !important;
  			margin-bottom: 0.8em !important;
  			border-bottom: 2px solid #e5e7eb;
  			padding-bottom: 0.3em;
			}

			/* 記事本文の H2（中見出し） */
			.prose h2 {
  			font-size: 1.4em !important;
  			margin-top: 1.8em !important;
  			margin-bottom: 0.6em !important;
  			border-bottom: 2px solid var(--accent) !important; /* 深緑の線 */
    		color: var(--accent) !important;
  			padding-bottom: 0.2em;
			}

			/* 記事本文の H3（小見出し） */
			.prose h3 {
  			font-size: 1.2em !important;
  			margin-top: 1.5em !important;
  			margin-bottom: 0.5em !important;
  			font-weight: 600;
			}

			/* 本文の文字サイズと行間 */
			.prose p {
  			font-size: 1rem !important;
  			line-height: 1.8 !important;
  			margin-bottom: 1.5em !important;
			}

			/* テーブルのスタイル改善 */
			.prose table {
  			font-size: 0.9rem !important;
			}
			
    		.back-btn {
   			 padding: 0.6rem 2rem;
    		border: 1px solid var(--accent);
    		color: var(--accent);
    		text-decoration: none;
    		border-radius: 50px;
    		font-size: 0.9rem;
    		transition: all 0.3s ease;
  			}
  			.back-btn:hover {
    		background-color: var(--accent);
    		color: white;
  			}

		</style>
	</head>

<body>
  <Header />
  <main>
    <article>
      <div class="hero-image">
        {heroImage ? (
          <Image width={1020} height={510} src={heroImage} alt="" />
        ) : (
          /* ここにランダム画像を表示させる処理を足すこともできますが、
             まずはシンプルに「ある時だけ」のままにしています */
          <div style="height: 100px;"></div> 
        )}
      </div>

      <div class="prose">
        <div class="title">
          <nav style="font-size: 0.8rem; margin-bottom: 1rem; color: var(--gray);">
             <a href="/" style="color: var(--gray);">Home</a> / 
             <a href="/blog" style="color: var(--gray);">Blog</a> / 
             <span>Reading...</span>
          </nav>
          
          <div class="date">
            <FormattedDate date={pubDate} />
            </div>
          <h1>{title}</h1>
          <hr />
        </div>
        
        <slot />

		<div style="background-color: #f2f4f0; padding: 2rem; border-radius: 15px; margin: 3rem 0; text-align: center;">
    <h3 style="margin-top: 0; color: var(--accent); font-size: 1.2rem;">Enjoying the Game Life?</h3>
    <p style="font-size: 0.9rem; color: #666;">
        35歳からの大人ゲーマー向けコミュニティ<br />
        <strong>AFTERGLOW HUB</strong> で仲間を探してみませんか？
    </p>
    <a href="https://game.afterglowhub.com" target="_blank" style="display: inline-block; background-color: var(--accent); color: white; padding: 0.6rem 1.5rem; border-radius: 25px; text-decoration: none; font-size: 0.85rem;">
        コミュニティを覗いてみる →
    </a>
</div>

        <div class="back-to-blog">
          <a href="/blog" class="back-btn">← 記事一覧に戻る</a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</body>
</html>
