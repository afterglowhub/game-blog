---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}

			/* =========================================
				日本語向けサイズ調整 & 崩れ防止
			   ========================================= */

			.title h1 {
				font-size: 2em !important;
				line-height: 1.3 !important;
				margin: 0 0 0.5em 0 !important;
			}

			.prose h2 {
				font-size: 1.4em !important;
				margin-top: 1.8em !important;
				margin-bottom: 0.6em !important;
				border-bottom: 2px solid var(--accent) !important;
				color: var(--accent) !important;
				padding-bottom: 0.2em;
			}

			.prose h3 {
				font-size: 1.2em !important;
				margin-top: 1.5em !important;
				margin-bottom: 0.5em !important;
				font-weight: 600;
			}

			.prose p {
				font-size: 1rem !important;
				line-height: 1.8 !important;
				margin-bottom: 1.5em !important;
			}

			/* コードブロックの崩れ防止（スマホで横スクロール可能に） */
			.prose pre {
				font-size: 0.85rem !important;
				padding: 1rem !important;
				overflow-x: auto !important;
				white-space: pre !important; /* 勝手に改行させない */
				word-wrap: normal !important;
				border-radius: 8px;
			}
			
			.prose code {
				font-size: 0.85rem !important;
			}

			/* 戻るボタンの割れ防止 */
			.back-to-blog {
				display: flex;
				justify-content: center;
				margin-top: 4rem;
				padding: 0 1rem;
			}
			.back-btn {
				display: inline-block;
				padding: 0.8rem 2.5rem; /* 左右の余白を多めに */
				border: 1px solid var(--accent);
				color: var(--accent);
				text-decoration: none;
				border-radius: 50px;
				font-size: 0.95rem;
				transition: all 0.3s ease;
				white-space: nowrap; /* 2行にさせない */
				text-align: center;
			}
			.back-btn:hover {
				background-color: var(--accent);
				color: white;
			}

			/* スマホ専用の余白最適化 */
			@media (max-width: 720px) {
				.prose {
					max-width: 95%; /* 左右の余白を削って文字を広く */
					padding: 0.5rem;
				}
				.title h1 {
					font-size: 1.6em !important;
				}
				/* コード内の文字が小さすぎないよう微調整 */
				.prose pre {
					font-size: 0.8rem !important;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage ? (
						<Image width={1020} height={510} src={heroImage} alt="" />
					) : (
						<div style="height: 60px;"></div> 
					)}
				</div>

				<div class="prose">
					<div class="title">
						<nav style="font-size: 0.8rem; margin-bottom: 1rem; color: var(--gray);">
							<a href="/" style="color: var(--gray);">Home</a> / 
							<a href="/blog" style="color: var(--gray);">Blog</a> / 
							<span>Reading...</span>
						</nav>
						<div class="date">
							<FormattedDate date={pubDate} />
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					
					<slot />

					<div style="background-color: #f2f4f0; padding: 2rem 1.5rem; border-radius: 15px; margin: 4rem 0; text-align: center;">
						<h3 style="margin-top: 0; color: var(--accent); font-size: 1.2rem;">Enjoying the Game Life?</h3>
						<p style="font-size: 0.9rem; color: #666; margin-bottom: 1.5rem;">
							35歳以上の大人ゲーマー向けコミュニティ<br />
							<strong>AFTERGLOW HUB</strong> で仲間を探してみませんか？
						</p>
						<a href="https://game.afterglowhub.com" target="_blank" style="display: inline-block; background-color: var(--accent); color: white; padding: 0.7rem 1.5rem; border-radius: 25px; text-decoration: none; font-size: 0.85rem; font-weight: bold;">
							コミュニティを覗いてみる →
						</a>
					</div>

					<div class="back-to-blog">
						<a href="/blog" class="back-btn">← 記事一覧に戻る</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>