---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<div style="width: 100%; max-width: 1200px; margin: 0 auto; padding: 0;">
			<img 
				src="/images/hero-topimage.png"
				alt="Game30" 
				style="width: 100%; height: 350px; object-fit: cover; border-radius: 0 0 20px 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);"
			/>
		</div>

		<main style="max-width: 720px; margin: 0 auto; padding: 2rem 1rem;">
			<h1 style="font-size: 1.6rem; font-weight: 500; letter-spacing: 0.05em; color: #444; margin-top: 3rem; margin-bottom: 1.5rem; text-align: center;">
    	Lv.30↑ の背伸びしないWebライフ
		</h1>
			
			<p style="font-size: 0.95rem; color: #666; line-height: 1.8; text-align: center; max-width: 500px; margin: 0 auto 2rem;">
    ゲームとWeb開発の記録を綴る個人ブログです。<br />
    「自分にとってちょうどいい、スマートな運用」をテーマに、試行錯誤の過程をシェアしています。
</p>

			<section style="background-color: #f9f9f9; padding: 1.5rem; border-radius: 8px; border: 1px solid #eee; margin: 2rem 0;">
				<h2 style="margin-top: 0; font-size: 1.2em;">運営プロジェクト</h2>
				<p style="margin-bottom: 0.5rem;">
					<strong>Game30</strong><br />
					30歳以上の大人ゲーマー向け、安心重視のフレンド募集・コミュニティサイト
				</p>
				<a href="https://game.game30.net" target="_blank" rel="noopener noreferrer" style="color: #3273dc; font-weight: bold; text-decoration: underline;">
					公式サイトをチェックする →
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>