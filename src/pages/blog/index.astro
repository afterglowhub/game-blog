---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 3rem 1.5rem;
				box-sizing: border-box;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem); /* PCでは2列 */
				margin-bottom: 1rem;
			}
			/* 1番目の記事を巨大化させず、他と揃える */
			ul li:first-child {
				width: calc(50% - 1rem);
				text-align: left;
			}
			ul li:first-child .title {
				font-size: 1.2rem;
			}
			ul li:first-child img {
				width: 100%;
			}
			
			ul li img {
				border-radius: 12px;
				transition: all 0.4s ease;
				box-shadow: 0 4px 10px rgba(0,0,0,0.05);
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			.title {
				margin: 0.5rem 0 0.2rem 0;
				color: var(--accent); /* 大人女子グリーン */
				line-height: 1.4;
				font-size: 1.2rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}

			/* ホバー時の優雅なエフェクト */
			ul li a:hover img {
				transform: scale(1.02);
				box-shadow: 0 10px 20px rgba(85, 107, 47, 0.15);
				filter: brightness(1.05);
			}

			/* --- スマホ表示の「崩れ」を解消 --- */
			@media (max-width: 720px) {
				main {
					padding: 1.5rem 1rem;
				}
				ul {
					gap: 2.5rem; /* 記事同士の間隔を広げて見やすく */
				}
				ul li, ul li:first-child {
					width: 100%; /* スマホでは潔く1列 */
					text-align: center;
				}
				.title {
					font-size: 1.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => {
							// 1から6の整数をランダムに生成
							const randomNumber = Math.floor(Math.random() * 6) + 1;
							const randomImage = `/images/hero-sample${randomNumber}.png`;

							return (
								<li>
									<a href={`/blog/${post.id}/`}>
										<img 
											width={720} 
											height={360} 
											src={post.data.heroImage || randomImage} 
											alt={post.data.title} 
											style="aspect-ratio: 16/9; object-fit: cover;"
										/>
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>