---
const today = new Date();
---

<footer>
	<div class="footer-row">
		<span>&copy; {today.getFullYear()} AFTERGLOW HUB.</span>
		<div class="social-links">
			<a href="https://x.com/AFTERGLOWHUB" target="_blank">x</a>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 1.5rem 1rem;
		background: #ffffff;
		border-top: 1px solid #f8f8f8; /* さらに薄い線で清潔感を */
	}

	.footer-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 0.8rem; /* コピーライトとxの距離 */
		font-size: 0.7rem;
		color: rgb(var(--gray));
		white-space: nowrap; /* 1行を死守 */
	}

	.social-links a {
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.3s ease;
		/* 小さな「x」を押しやすくするため少しだけ余白を持たせる */
		padding: 0.2rem 0.5rem;
	}

	.social-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.footer-row {
			font-size: 0.65rem;
			gap: 0.5rem;
		}
	}
</style>