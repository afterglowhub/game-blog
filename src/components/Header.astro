---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		
		<button id="menu-toggle" aria-label="Menu">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
		</button>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>

		<div class="social-links">
			</div>
	</nav>
</header>

<script>
	// スマホメニューの開閉スクリプト
	const btn = document.getElementById('menu-toggle');
	const links = document.querySelector('.internal-links');
	btn?.addEventListener('click', () => links?.classList.toggle('show'));
</script>

<style>
	header {
		position: sticky; /* 追従 */
		top: 0;
		z-index: 100;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid #f0f0f0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		height: 60px;
	}
	#menu-toggle {
		display: none; /* デスクトップでは隠す */
	}

	@media (max-width: 720px) {
		nav {
        	display: flex;
        	justify-content: space-between; /* 両端に広げる */
        	align-items: center;
        	width: 100%;
        	padding: 0 1rem; /* 画面端に密着しないように少し余白を */
    	}

		#menu-toggle {
        	display: block;
        	background: none;
        	border: none;
        	color: var(--accent);
        	padding: 0.5rem; /* タップしやすく */
        	margin-right: -0.5rem; /* 右端にピタッと寄せる調整 */
        	order: 2; /* 確実に右側に配置 */
    	}

    	h2 {
        	margin: 0;
        	order: 1; /* 確実に左側に配置 */
    	}
		
		.internal-links {
			display: none; /* スマホでは最初隠す */
			position: absolute;
			top: 60px;
			left: 0;
			width: 100%;
			background: white;
			flex-direction: column;
			padding: 1rem 0;
			box-shadow: 0 10px 10px rgba(0,0,0,0.05);
			z-index: 99;
		}
		
		.internal-links.show {
			display: flex;
		}
		
		.internal-links a {
			padding: 1rem;
			border-bottom: none;
		}
		/* タイトルをスマホで中央に寄せるなら */
		h2 { font-size: 0.9em; }
	}
</style>